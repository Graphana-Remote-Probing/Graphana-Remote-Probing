# Non-secret configuration template. The installer writes the live file.
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom
GRAFANA_PROM_USER=000000
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net
GRAFANA_LOKI_USER=000000
GRAFANA_SELECTOR={job=~"^(target-http|target-dns)$"}
DATA_ROOT=/data/Graphana_Proping
FEATURE_CONFIG=/etc/Graphana_Proping/targets.json
TOKEN_EXPIRY_DATE=none
TOKEN_WARN_DAYS=30,7
HTTP_TIMEOUT_SECONDS=30
LOOKBACK_MINUTES=30
LOG_LIMIT=5000
